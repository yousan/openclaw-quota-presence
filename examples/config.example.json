{
  "channels": {
    "discord": {
      "actions": {
        "presence": true
      }
    }
  },
  "plugins": {
    "allow": [
      "quota-presence"
    ],
    "load": {
      "paths": [
        "/path/to/openclaw-quota-presence"
      ]
    },
    "entries": {
      "quota-presence": {
        "enabled": true,
        "hooks": {
          "allowConversationAccess": true
        },
        "config": {
          "items": [
            {
              "label": "Argon",
              "source": "agy:gemini-4-argon"
            },
            {
              "label": "GPT",
              "source": "usage:openai"
            },
            {
              "label": "Claude",
              "source": "claude-code",
              "windows": [
                "5h",
                "week"
              ]
            }
          ],
          "intervalMs": 900000,
          "minUpdateIntervalMs": 120000,
          "itemTemplate": "{label} {remaining}%{stale}",
          "claudeCode": {
            "enabled": true
          }
        }
      }
    }
  }
}
