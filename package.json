{
  "name": "@yousan/openclaw-quota-presence",
  "version": "0.4.0",
  "description": "Shows how much quota is left on each AI provider as the bot's Discord custom status, through an OpenClaw automation script. Reads agy /usage and OpenClaw's provider usage; no model calls.",
  "type": "module",
  "license": "MIT",
  "author": "yousan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yousan/openclaw-quota-presence.git"
  },
  "homepage": "https://github.com/yousan/openclaw-quota-presence#readme",
  "bugs": {
    "url": "https://github.com/yousan/openclaw-quota-presence/issues"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "discord",
    "presence",
    "quota",
    "usage"
  ],
  "files": [
    "src",
    "openclaw",
    "automation",
    "openclaw.plugin.json",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.2"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./openclaw/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.2",
      "minGatewayVersion": "2026.10.2"
    },
    "build": {
      "openclawVersion": "2026.10.2",
      "pluginSdkVersion": "2026.10.2"
    },
    "install": {
      "npmSpec": "@yousan/openclaw-quota-presence",
      "minHostVersion": ">=2026.10.2"
    }
  }
}
